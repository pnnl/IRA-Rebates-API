{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_name": {
      "$anchor": "file_name",
      "type": "string",
      "pattern": "^[0-9a-zA-Z\\-.\\(\\)_ ]+$",
      "minLength": 2,
      "maxLength": 64,
      "description": "This file name will be associated with the uploaded file and will be shown wherever a list of the uploaded files for a reservation is returned.",
      "title": "File name"
    },
    "file_type": {
      "$anchor": "homes_file_type",
      "enum": [
        "CSV",
        "HEIC",
        "HPXML_MEASURED",
        "HPXML_MODELED_RECOMMENDED",
        "HPXML_MODELED_REQUIRED",
        "JPEG",
        "PDF",
        "PNG",
        "BUILDINGSYNC",
        "JSON",
        "EXCEL"
      ],
      "title": "File type"
    },
    "file_purpose": {
      "$anchor": "homes_file_purpose",
      "enum": [
        "POST_RETROFIT_MODEL",
        "PRE_AND_POST_RETROFIT_MODELS",
        "PRE_RETROFIT_MODEL",
        "QUALITY_ASSURANCE",
        "MEASURED_SAVINGS_CALCULATION_OUTPUT_FILE",
        "MODEL_FILE_WITH_APPROVED_DOE_EXCEPTION"
      ],
      "title": "File purpose",
      "description": "When the MODEL_FILE_WITH_APPROVED_DOE_EXCEPTION option is used, Schematron validation will not be applied. The MODEL_FILE_WITH_APPROVED_DOE_EXCEPTION may only be used for files that have received DOE approval to do so on a case-by-case basis."
    },
    "file_url": {
      "type": "string",
      "format": "url"
    },
    "description": {
      "$anchor": "description",
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "file_name",
    "file_type",
    "file_purpose",
    "file_url"
  ]
}
