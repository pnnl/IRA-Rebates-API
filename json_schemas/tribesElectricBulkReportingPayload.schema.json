{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/tribesElectrificationBulkReporting",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "address_id": {
        "$ref": "/schemas/definitions#address_id"
      },
      "applicant_id": {
        "$ref": "/schemas/definitions#applicant_id"
      },
      "building_project_type": {
        "$ref": "/schemas/definitions#electric_building_project_type"
      },
      "claimant_type": {
        "$ref": "/schemas/definitions#electric_claimant_type"
      },
      "construction_type": {
        "$ref": "/schemas/definitions#construction_type"
      },
      "contractor_company_name": {
        "$ref": "/schemas/definitions#contractor_company_name"
      },
      "contractor_incentive": {
        "$ref": "/schemas/definitions#contractor_incentive",
        "description": "This is the amount the jurisdiction will pay to a contractor as an incentive. This is separate from any contractor DAC incentive."
      },
      "dwelling_unit_income_bucket": {
        "$ref": "/schemas/definitions#electric_dwelling_unit_income_bucket"
      },
      "equipment_and_material_cost": {
        "$ref": "/schemas/definitions#electric_equipment_and_material_cost",
        "description": "The total cost of qualifying equipment and materials associated with this rebate."
      },
      "installation_cost": {
        "$ref": "/schemas/definitions#installation_cost",
        "description": "The installation costs associated with this rebate. To qualify, the installation must be performed by an approved contractor. Also see is_contractor_eligible."
      },
      "installation_type": {
        "$ref": "/schemas/definitions#installation_type"
      },
      "is_contractor_eligible": {
        "$ref": "/schemas/definitions#is_contractor_eligible",
        "description": "The contractor is eligible if they are on the jurisdiction's approved list."
      },
      "jurisdiction_attests_proof_of_identity_ownership_income": {
        "$ref": "/schemas/definitions#jurisdiction_attests_proof_of_identity_ownership_income"
      },
      "post_retrofit_inspection_passed": {
        "$ref": "/schemas/definitions#post_retrofit_inspection_passed"
      },
      "limited_assessment": {
        "$ref": "/schemas/electrificationLimitedAssessment",
        "properties": {
          "cooling_systems": {
            "items": {
              "properties": {
                "percent_conditioned_floor_area_served": {
                  "description": "For estimating this percentage, use the total conditioned floor area"
                }
              }
            }
          },
          "heating_systems": {
            "items": {
              "properties": {
                "percent_conditioned_floor_area_served": {
                  "description": "For estimating this percentage, use the total conditioned floor area"
                }
              }
            }
          }
        }
      },
      "mf_building_income_bucket": {
        "$ref": "/schemas/definitions#electric_mf_building_income_bucket"
      },
      "num_occupied_units": {
        "$ref": "/schemas/definitions#num_occupied_units"
      },
      "num_units": {
        "$ref": "/schemas/definitions#num_units"
      },
      "num_units_meeting_income_bucket": {
        "$ref": "/schemas/definitions#num_units_meeting_income_bucket"
      },
      "original_component_details": {
        "$ref": "/schemas/originalComponentDetails"
      },
      "product_info": {
        "$ref": "/schemas/definitions#product_info"
      },
      "project_completion_date": {
        "$ref": "/schemas/definitions#project_completion_date"
      },
      "project_id": {
        "$ref": "/schemas/definitions#project_id",
        "description": "This is a unique string supplied by the API user that is used to associate one or more reservations to a single project. Note: it is recommended that a uuid be used to avoid duplication, but the API user can use any other system that they find convenient, provided that it is unique for the jurisdiction."
      },
      "purchase_date": {
        "$ref": "/schemas/definitions#purchase_date"
      },
      "rebate_deducted": {
        "$ref": "/schemas/definitions#rebate_deducted"
      },
      "safety_checks": {
        "$ref": "/schemas/definitions#safety_checks"
      },
      "unit_name_or_number": {
        "$ref": "/schemas/definitions#unit_name_or_number"
      },
      "upgrade_component_details": {
        "$ref": "/schemas/upgradeComponentDetails",
        "properties": {
          "insulation_air_sealing_ventilation_upgrade_details": {
            "items": {
              "anyOf": [
                {
                  "$ref": "/schemas/airSealing#upgrade_component_details"
                },
                {
                  "$ref": "/schemas/ceilingInsulation#upgrade_component_details"
                },
                {
                  "$ref": "/schemas/wallInsulation#upgrade_component_details"
                },
                {
                  "$ref": "/schemas/ductSealing#upgrade_component_details"
                },
                {
                  "$ref": "/schemas/ductInsulation#upgrade_component_details"
                },
                {
                  "$ref": "/schemas/floorAboveConditionedSpaceInsulation#upgrade_component_details",
                  "properties": {
                    "percent_floor_receiving_additional_insulation": {
                      "description": "For estimating this percentage, use the total conditioned floor area"
                    }
                  }
                },
                {
                  "$ref": "/schemas/floorAboveUnconditionedSpaceInsulation#upgrade_component_details",
                  "properties": {
                    "percent_floor_receiving_additional_insulation": {
                      "description": "For estimating this percentage, use the total conditioned floor area"
                    }
                  }
                },
                {
                  "$ref": "/schemas/foundationInsulation#upgrade_component_details",
                  "properties": {
                    "percent_foundation_perimeter_receiving_additional_insulation": {
                      "description": "For estimating this percentage, use the distance around the footprint"
                    }
                  }
                },
                {
                  "$ref": "/schemas/ventilation#upgrade_component_details"
                }
              ]
            }
          }
        }
      },
      "upgrade_type": {
        "$ref": "/schemas/definitions#upgrade_type"
      }
    },
    "required": [
      "address_id",
      "applicant_id",
      "building_project_type",
      "claimant_type",
      "construction_type",
      "equipment_and_material_cost",
      "installation_type",
      "product_info",
      "jurisdiction_attests_proof_of_identity_ownership_income",
      "project_completion_date",
      "purchase_date",
      "rebate_deducted",
      "upgrade_type"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_CENTRAL",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_CENTRAL"
            }
          },
          "required": [
            "num_occupied_units",
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "mf_building_income_bucket",
            "num_occupied_units",
            "num_units",
            "num_units_meeting_income_bucket"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "dwelling_unit_income_bucket"
                ]
              },
              {
                "required": [
                  "unit_name_or_number"
                ]
              }
            ]
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_IN_UNIT_PART_OF_BUILDING_PROJECT",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_IN_UNIT_PART_OF_BUILDING_PROJECT"
            }
          },
          "required": [
            "num_occupied_units",
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "mf_building_income_bucket",
            "num_units",
            "num_units_meeting_income_bucket",
            "project_id",
            "unit_name_or_number"
          ],
          "not": {
            "required": [
              "dwelling_unit_income_bucket"
            ]
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_IN_UNIT",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_IN_UNIT"
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "dwelling_unit_income_bucket",
            "num_units",
            "unit_name_or_number"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mf_building_income_bucket"
                ]
              },
              {
                "required": [
                  "num_occupied_units"
                ]
              },
              {
                "required": [
                  "num_units_meeting_income_bucket"
                ]
              }
            ]
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed for single family building_project_type",
        "if": {
          "properties": {
            "building_project_type": {
              "enum": [
                "MANUFACTURED",
                "SINGLE_FAMILY_ATTACHED",
                "SINGLE_FAMILY_DETACHED"
              ]
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "dwelling_unit_income_bucket"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mf_building_income_bucket"
                ]
              },
              {
                "required": [
                  "num_occupied_units"
                ]
              },
              {
                "required": [
                  "num_units"
                ]
              },
              {
                "required": [
                  "num_units_meeting_income_bucket"
                ]
              }
            ]
          }
        }
      },
      {
        "$comment": "The appropriate schema must be used for original_component_details and upgrade_component_details depending on upgrade_type.",
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_CLOTHES_DRYER"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_clothes_dryer_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "heat_pump_clothes_dryer_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRIC_COOKING_APPLIANCE"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "original_component_details": {
              "required": [
                "electric_cooking_appliance_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "electric_cooking_appliance_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_WATER_HEATER"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_water_heater_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "heat_pump_water_heater_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRICAL_PANEL"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "original_component_details": {
              "required": [
                "electrical_panel_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "electrical_panel_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "INSULATION_AIR_SEALING_VENTILATION"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "original_component_details": {
              "required": [
                "insulation_air_sealing_ventilation_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "insulation_air_sealing_ventilation_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
            }
          },
          "required": [
            "original_component_details",
            "upgrade_type"
          ]
        },
        "then": {
          "not": {
            "required": [
              "upgrade_component_details"
            ]
          },
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_for_space_heating_or_cooling_original_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRIC_WIRING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "original_component_details"
                ]
              },
              {
                "required": [
                  "upgrade_component_details"
                ]
              }
            ]
          },
          "error_msg": "'original_component_details' and 'upgrade_component_details' are not allowed for 'ELECTRIC_WIRING' upgrade_type."
        }
      },
      {
        "$comment": "Determine when installation_type must be CONTRACTOR_INSTALLED and when contractor_company_name, contractor_incentive, is_contractor_eligible, and safety_checks are required, optional, or not allowed",
        "if": {
          "oneOf": [
            {
              "properties": {
                "upgrade_type": {
                  "enum": [
                    "ELECTRICAL_PANEL",
                    "ELECTRIC_WIRING",
                    "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
                  ]
                }
              }
            },
            {
              "required": [
                "upgrade_component_details"
              ],
              "properties": {
                "upgrade_type": {
                  "const": "INSULATION_AIR_SEALING_VENTILATION"
                },
                "upgrade_component_details": {
                  "properties": {
                    "insulation_air_sealing_ventilation_upgrade_details": {
                      "contains": {
                        "title": "Air Sealing Original Component Details Object",
                        "properties": {
                          "upgrade_subtype": {
                            "const": "AIR_SEALING"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "then": {
          "required": [
            "contractor_company_name",
            "contractor_incentive",
            "is_contractor_eligible",
            "safety_checks"
          ],
          "properties": {
            "installation_type": {
              "const": "CONTRACTOR_INSTALLED"
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "installation_type": {
                "const": "DO_IT_YOURSELF"
              }
            },
            "required": [
              "installation_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "contractor_company_name"
                  ]
                },
                {
                  "required": [
                    "contractor_incentive"
                  ]
                },
                {
                  "required": [
                    "is_contractor_eligible"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "$comment": "Determine when ahri_reference_number, model_number, product_description and upc in product_info are required, optional, or not allowed",
        "properties": {
          "product_info": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "ahri_reference_number"
                  ]
                },
                {
                  "required": [
                    "model_number"
                  ]
                },
                {
                  "required": [
                    "upc"
                  ]
                }
              ],
              "error_msg": "Each item in 'product_info' must have at least one of 'ahri_reference_number', 'model_number', or 'upc'."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "product_info": {
              "items": {
                "anyOf": [
                  {
                    "required": [
                      "ahri_reference_number"
                    ]
                  },
                  {
                    "required": [
                      "model_number"
                    ]
                  }
                ],
                "error_msg": "If 'upgrade_type' is 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING', each item in 'product_info' must have at least one of 'ahri_reference_number' or 'model_number'."
              }
            }
          }
        }
      },
      {
        "if": {
          "not": {
            "properties": {
              "upgrade_type": {
                "enum": [
                  "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING",
                  "HEAT_PUMP_WATER_HEATER"
                ]
              }
            }
          }
        },
        "then": {
          "properties": {
            "product_info": {
              "items": {
                "not": {
                  "required": [
                    "ahri_reference_number"
                  ]
                },
                "error_msg": "If 'upgrade_type' is not 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING' or 'HEAT_PUMP_WATER_HEATER', 'product_info' must not have 'ahri_reference_number'."
              }
            }
          }
        }
      }
    ]
  }
}
