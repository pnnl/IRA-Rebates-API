{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/airSealing",
  "title": "Air Selaing",
  "type": "object",
  "properties": {
    "original_component_details": {
      "$anchor": "original_component_details",
      "title": "Air Sealing Original Component Details",
      "type": "object",
      "description": "The preexisting conditions associated with this improvement",
      "properties": {
        "cfm50": {
          "$ref": "#/$defs/cfm50"
        },
        "is_leakage_rate_known": {
          "$ref": "#/$defs/is_leakage_rate_known"
        },
        "upgrade_subtype": {
          "$ref": "#/$defs/upgrade_subtype"
        }
      },
      "required": [
        "is_leakage_rate_known",
        "upgrade_subtype"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "is_leakage_rate_known": {
            "const": true
          }
        },
        "required": [
          "is_leakage_rate_known"
        ]
      },
      "then": {
        "required": [
          "cfm50"
        ],
        "error_msg": "If 'is_leakage_rate_known' is 'true', then 'cfm50' must be provided."
      },
      "else": {
        "not": {
          "required": [
            "cfm50"
          ]
        },
        "error_msg": "If 'is_leakage_rate_known' is 'false', then 'cfm50' must not be provided."
      }
    },
    "upgrade_component_details": {
      "$anchor": "upgrade_component_details",
      "title": "Air Sealing Upgrade Component Details",
      "type": "object",
      "description": "Details that describe this improvement",
      "properties": {
        "cfm50": {
          "$ref": "#/$defs/cfm50"
        },
        "is_homeowner_aware_combustion_safety_tests_are_highly_recommended": {
          "type": "boolean",
          "description": "Is the homeowner aware that combustion safety tests are highly recommended for homes with any combustion appliances after air sealing projects are completed?"
        },
        "is_leakage_rate_known": {
          "$ref": "#/$defs/is_leakage_rate_known"
        },
        "locations": {
          "type": "array",
          "title": "Location Item",
          "items": {
            "enum": [
              "ATTIC",
              "FLOOR_FOUNDATION",
              "WALLS_WINDOWS_DOORS"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "upgrade_subtype": {
          "$ref": "#/$defs/upgrade_subtype"
        }
      },
      "required": [
        "is_homeowner_aware_combustion_safety_tests_are_highly_recommended",
        "is_leakage_rate_known",
        "locations",
        "upgrade_subtype"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "is_leakage_rate_known": {
            "const": true
          }
        },
        "required": [
          "is_leakage_rate_known"
        ]
      },
      "then": {
        "required": [
          "cfm50"
        ],
        "error_msg": "If 'is_leakage_rate_known' is 'true', then 'cfm50' must be provided."
      },
      "else": {
        "not": {
          "required": [
            "cfm50"
          ]
        },
        "error_msg": "If 'is_leakage_rate_known' is 'false', then 'cfm50' must not be provided."
      }
    }
  },
  "$defs": {
    "cfm50": {
      "type": "integer",
      "minimum": 100
    },
    "is_leakage_rate_known": {
      "type": "boolean"
    },
    "upgrade_subtype": {
      "const": "AIR_SEALING"
    }
  }
}
