{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/electrificationProductRedemption",
  "type": "object",
  "title": "Electric Product Redemptions Payload",
  "properties": {
    "equipment_and_material_cost": {
      "$ref": "/schemas/definitions#electric_equipment_and_material_cost",
      "description": "The total cost of the qualifying products purchased."
    },
    "installation_cost": {
      "$ref": "/schemas/definitions#installation_cost",
      "description": "Use this if installation cost is included at the point of purchase of the qualifying product(s), otherwise set this to 0."
    },
    "is_mail_in_rebate": {
      "$ref": "/schemas/definitions#is_mail_in_rebate"
    },
    "product_info": {
      "$ref": "/schemas/definitions#product_info"
    },
    "purchase_date": {
      "$ref": "/schemas/definitions#purchase_date"
    },
    "purchase_date_time": {
      "$ref": "/schemas/definitions#purchase_date_time"
    },
    "rebate_deducted": {
      "$ref": "/schemas/definitions#rebate_deducted"
    },
    "upgrade_type": {
      "$ref": "/schemas/definitions#upgrade_type"
    },
    "vendor_id": {
      "$ref": "/schemas/definitions#vendor_id"
    }
  },
  "required": [
    "equipment_and_material_cost",
    "installation_cost",
    "product_info",
    "rebate_deducted",
    "upgrade_type",
    "vendor_id"
  ],
  "oneOf": [
    {
      "required": [
        "purchase_date_time"
      ],
      "not": {
        "required": [
          "purchase_date"
        ]
      },
      "error_msg": "If 'purchase_date_time' is provided, 'purchase_date' must not be provided."
    },
    {
      "required": [
        "purchase_date"
      ],
      "not": {
        "required": [
          "purchase_date_time"
        ]
      },
      "error_msg": "If 'purchase_date' is provided, 'purchase_date_time' must not be provided."
    }
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "product_info": {
          "items": {
            "anyOf": [
              {
                "required": [
                  "ahri_reference_number"
                ]
              },
              {
                "required": [
                  "model_number"
                ]
              },
              {
                "required": [
                  "upc"
                ]
              }
            ],
            "error_msg": "Each 'product_info' must have at least one of 'ahri_reference_number', 'model_number', or 'upc'."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "upgrade_type": {
            "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
          }
        },
        "required": [
          "upgrade_type"
        ]
      },
      "then": {
        "properties": {
          "product_info": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "ahri_reference_number"
                  ]
                },
                {
                  "required": [
                    "model_number"
                  ]
                }
              ],
              "error_msg": "If 'upgrade_type' is 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING', each 'product_info' item must have at least one of 'ahri_reference_number' or 'model_number'."
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "upgrade_type": {
              "enum": [
                "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING",
                "HEAT_PUMP_WATER_HEATER"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "product_info": {
            "items": {
              "not": {
                "required": [
                  "ahri_reference_number"
                ]
              },
              "error_msg": "If 'upgrade_type' is other than 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING' and 'HEAT_PUMP_WATER_HEATER', 'ahri_reference_number' must not be provided."
            }
          }
        }
      }
    }
  ]
}
