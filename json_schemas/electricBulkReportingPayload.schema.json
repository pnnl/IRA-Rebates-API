{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/electrificationBulkReporting",
  "type": "array",
  "title": "Electric Bulk Reporting Payload",
  "items": {
    "type": "object",
    "title": "Electric Bulk reporting Payload Item",
    "properties": {
      "address_id": {
        "$ref": "/schemas/definitions#address_id"
      },
      "applicant_id": {
        "$ref": "/schemas/definitions#applicant_id"
      },
      "building_name_or_number": {
        "$ref": "/schemas/definitions#building_name_or_number"
      },
      "building_project_type": {
        "$ref": "/schemas/definitions#electric_building_project_type"
      },
      "claimant_type": {
        "$ref": "/schemas/definitions#electric_claimant_type"
      },
      "construction_type": {
        "$ref": "/schemas/definitions#construction_type"
      },
      "contractor_company_name": {
        "$ref": "/schemas/definitions#contractor_company_name"
      },
      "contractor_dac_incentive": {
        "$ref": "/schemas/definitions#contractor_dac_incentive"
      },
      "contractor_incentive": {
        "$ref": "/schemas/definitions#contractor_incentive"
      },
      "contractor_name": {
        "$ref": "/schemas/definitions#contractor_name"
      },
      "dwelling_unit_income_bucket": {
        "$ref": "/schemas/definitions#electric_dwelling_unit_income_bucket"
      },
      "energy_data_evaluation_permission": {
        "$ref": "/schemas/definitions#energy_data_evaluation_permission"
      },
      "equipment_and_material_cost": {
        "$ref": "/schemas/definitions#electric_equipment_and_material_cost"
      },
      "external_rebate_id": {
        "$ref": "/schemas/definitions#external_rebate_id"
      },
      "install_vendor_id": {
        "$ref": "/schemas/definitions#vendor_id",
        "title": "Install vendor id"
      },
      "installation_cost": {
        "$ref": "/schemas/definitions#installation_cost"
      },
      "installation_type": {
        "$ref": "/schemas/definitions#installation_type"
      },
      "is_contractor_eligible": {
        "$ref": "/schemas/definitions#is_contractor_eligible"
      },
      "is_disadvantaged_community": {
        "$ref": "/schemas/definitions#is_disadvantaged_community"
      },
      "is_mail_in_rebate": {
        "$ref": "/schemas/definitions#is_mail_in_rebate"
      },
      "limited_assessment": {
        "$ref": "/schemas/electrificationLimitedAssessment"
      },
      "mf_building_income_bucket": {
        "$ref": "/schemas/definitions#electric_mf_building_income_bucket"
      },
      "mf_conditioned_floor_area": {
        "$ref": "/schemas/definitions#mf_conditioned_floor_area"
      },
      "mf_num_bedrooms": {
        "$ref": "/schemas/definitions#mf_num_bedrooms"
      },
      "num_occupied_units": {
        "$ref": "/schemas/definitions#num_occupied_units"
      },
      "num_units": {
        "$ref": "/schemas/definitions#num_units"
      },
      "num_units_meeting_income_bucket": {
        "$ref": "/schemas/definitions#num_units_meeting_income_bucket"
      },
      "original_component_details": {
        "$ref": "/schemas/originalComponentDetails"
      },
      "post_retrofit_inspection_passed": {
        "$ref": "/schemas/definitions#post_retrofit_inspection_passed"
      },
      "product_info": {
        "$ref": "/schemas/definitions#product_info"
      },
      "product_vendor_id": {
        "$ref": "/schemas/definitions#vendor_id",
        "title": "Product vendor id"
      },
      "project_completion_date": {
        "$ref": "/schemas/definitions#project_completion_date"
      },
      "project_id": {
        "$ref": "/schemas/definitions#project_id"
      },
      "project_reservation_date": {
        "$ref": "/schemas/definitions#project_reservation_date"
      },
      "purchase_date": {
        "$ref": "/schemas/definitions#purchase_date"
      },
      "purchase_date_time": {
        "$ref": "/schemas/definitions#purchase_date_time"
      },
      "rebate_deducted": {
        "$ref": "/schemas/definitions#rebate_deducted"
      },
      "safety_checks": {
        "$ref": "/schemas/definitions#safety_checks"
      },
      "sf_conditioned_floor_area": {
        "$ref": "/schemas/definitions#sf_conditioned_floor_area"
      },
      "sf_num_bedrooms": {
        "$ref": "/schemas/definitions#sf_num_bedrooms"
      },
      "state_attests_new_construction_cost_effectiveness": {
        "$ref": "/schemas/definitions#state_attests_new_construction_cost_effectiveness"
      },
      "state_attests_proof_of_identity_ownership_income": {
        "$ref": "/schemas/definitions#state_attests_proof_of_identity_ownership_income"
      },
      "unit_name_or_number": {
        "$ref": "/schemas/definitions#unit_name_or_number"
      },
      "upgrade_component_details": {
        "$ref": "/schemas/upgradeComponentDetails"
      },
      "upgrade_type": {
        "$ref": "/schemas/definitions#upgrade_type"
      }
    },
    "required": [
      "address_id",
      "applicant_id",
      "building_project_type",
      "claimant_type",
      "construction_type",
      "energy_data_evaluation_permission",
      "equipment_and_material_cost",
      "installation_type",
      "post_retrofit_inspection_passed",
      "product_info",
      "product_vendor_id",
      "project_completion_date",
      "rebate_deducted",
      "state_attests_proof_of_identity_ownership_income",
      "upgrade_type"
    ],
    "oneOf": [
      {
        "required": [
          "purchase_date_time"
        ],
        "not": {
          "required": [
            "purchase_date"
          ]
        },
        "error_msg": "If 'purchase_date_time' is provided, then 'purchase_date' must not be provided."
      },
      {
        "required": [
          "purchase_date"
        ],
        "not": {
          "required": [
            "purchase_date_time"
          ]
        },
        "error_msg": "If 'purchase_date' is provided, then 'purchase_date_time' must not be provided."
      }
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_CENTRAL",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_CENTRAL"
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "mf_building_income_bucket",
            "num_occupied_units",
            "num_units",
            "num_units_meeting_income_bucket"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "dwelling_unit_income_bucket"
                ]
              },
              {
                "required": [
                  "unit_name_or_number"
                ]
              }
            ],
            "error_msg": "If 'building_project_type' is 'MULTIFAMILY_CENTRAL', then 'dwelling_unit_income_bucket' and 'unit_name_or_number' must not be provided."
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_IN_UNIT_PART_OF_BUILDING_PROJECT",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_IN_UNIT_PART_OF_BUILDING_PROJECT"
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "mf_building_income_bucket",
            "num_occupied_units",
            "num_units",
            "num_units_meeting_income_bucket",
            "project_id",
            "unit_name_or_number"
          ],
          "not": {
            "required": [
              "dwelling_unit_income_bucket"
            ],
            "error_msg": "If 'building_project_type' is 'MULTIFAMILY_IN_UNIT_PART_OF_BUILDING_PROJECT', then 'dwelling_unit_income_bucket' must not be provided."
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_IN_UNIT",
        "if": {
          "properties": {
            "building_project_type": {
              "const": "MULTIFAMILY_IN_UNIT"
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "dwelling_unit_income_bucket",
            "unit_name_or_number"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mf_building_income_bucket"
                ]
              },
              {
                "required": [
                  "num_occupied_units"
                ]
              },
              {
                "required": [
                  "num_units_meeting_income_bucket"
                ]
              }
            ],
            "error_msg": "If 'building_project_type' is 'MULTIFAMILY_IN_UNIT', then 'mf_building_income_bucket', 'num_occupied_units', and 'num_units_meeting_income_bucket' must not be provided."
          }
        }
      },
      {
        "$comment": "Determine which fields are required or not allowed for single family building_project_type",
        "if": {
          "properties": {
            "building_project_type": {
              "enum": [
                "MANUFACTURED",
                "SINGLE_FAMILY_ATTACHED",
                "SINGLE_FAMILY_DETACHED"
              ]
            }
          },
          "required": [
            "building_project_type"
          ]
        },
        "then": {
          "required": [
            "dwelling_unit_income_bucket"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mf_building_income_bucket"
                ]
              },
              {
                "required": [
                  "num_units"
                ]
              },
              {
                "required": [
                  "num_occupied_units"
                ]
              },
              {
                "required": [
                  "num_units_meeting_income_bucket"
                ]
              },
              {
                "required": [
                  "building_name_or_number"
                ]
              }
            ],
            "error_msg": "If 'building_project_type' is either 'SINGLE_FAMILY_ATTACHED', 'SINGLE_FAMILY_DETACHED', or 'MANUFACTURED', then 'mf_building_income_bucket', 'num_units', 'num_occupied_units', 'num_units_meeting_income_bucket', and 'building_name_or_number' must not be provided."
          }
        }
      },
      {
        "$comment": "The appropriate schema must be used for original_component_details and upgrade_component_details depending on upgrade_type.",
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_CLOTHES_DRYER"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details",
            "upgrade_component_details"
          ],
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_clothes_dryer_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "heat_pump_clothes_dryer_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRIC_COOKING_APPLIANCE"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details",
            "upgrade_component_details"
          ],
          "properties": {
            "original_component_details": {
              "required": [
                "electric_cooking_appliance_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "electric_cooking_appliance_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_WATER_HEATER"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details",
            "upgrade_component_details"
          ],
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_water_heater_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "heat_pump_water_heater_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRICAL_PANEL"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details",
            "upgrade_component_details"
          ],
          "properties": {
            "original_component_details": {
              "required": [
                "electrical_panel_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "electrical_panel_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "INSULATION_AIR_SEALING_VENTILATION"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details",
            "upgrade_component_details"
          ],
          "properties": {
            "original_component_details": {
              "required": [
                "insulation_air_sealing_ventilation_original_details"
              ]
            },
            "upgrade_component_details": {
              "required": [
                "insulation_air_sealing_ventilation_upgrade_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "original_component_details"
          ],
          "not": {
            "required": [
              "upgrade_component_details"
            ],
            "error_msg": "If 'upgrade_type' is 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING', then 'upgrade_component_details' must not be provided."
          },
          "properties": {
            "original_component_details": {
              "required": [
                "heat_pump_for_space_heating_or_cooling_original_details"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "ELECTRIC_WIRING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "original_component_details"
                ]
              },
              {
                "required": [
                  "upgrade_component_details"
                ]
              }
            ]
          },
          "error_msg": "If 'upgrade_type' is 'ELECTRIC_WIRING', then 'original_component_details' and 'upgrade_component_details' must not be provided."
        }
      },
      {
        "$comment": "Determine when contractor_company_name, contractor_name, contractor_dac_incentive, contractor_incentive, is_contractor_eligible, and safety_checks are required, optional, or not allowed",
        "if": {
          "properties": {
            "installation_type": {
              "const": "CONTRACTOR_INSTALLED"
            }
          },
          "required": [
            "installation_type"
          ]
        },
        "then": {
          "required": [
            "contractor_company_name",
            "contractor_incentive",
            "contractor_name",
            "is_contractor_eligible",
            "safety_checks"
          ]
        },
        "else": {
          "if": {
            "properties": {
              "installation_type": {
                "const": "DO_IT_YOURSELF"
              }
            },
            "required": [
              "installation_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "contractor_company_name"
                  ]
                },
                {
                  "required": [
                    "contractor_dac_incentive"
                  ]
                },
                {
                  "required": [
                    "contractor_incentive"
                  ]
                },
                {
                  "required": [
                    "contractor_name"
                  ]
                },
                {
                  "required": [
                    "is_contractor_eligible"
                  ]
                }
              ]
            },
            "error_msg": "If 'installation_type' is 'DO_IT_YOURSELF', then 'contractor_company_name', 'contractor_dac_incentive', 'contractor_incentive', 'contractor_name', and 'is_contractor_eligible' must not be provided."
          }
        }
      },
      {
        "$comment": "Determine when mf_conditioned_floor_area and sf_conditioned_floor_area are required",
        "if": {
          "properties": {
            "upgrade_type": {
              "enum": [
                "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING",
                "INSULATION_AIR_SEALING_VENTILATION"
              ]
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "if": {
            "properties": {
              "building_project_type": {
                "const": "MULTIFAMILY_CENTRAL"
              }
            },
            "required": [
              "building_project_type"
            ]
          },
          "then": {
            "required": [
              "mf_conditioned_floor_area"
            ]
          },
          "else": {
            "required": [
              "sf_conditioned_floor_area"
            ]
          }
        }
      },
      {
        "$comment": "Determine when mf_num_bedrooms and sf_num_bedrooms are required",
        "if": {
          "properties": {
            "upgrade_type": {
              "enum": [
                "HEAT_PUMP_CLOTHES_DRYER",
                "HEAT_PUMP_WATER_HEATER"
              ]
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "if": {
            "properties": {
              "building_project_type": {
                "const": "MULTIFAMILY_CENTRAL"
              }
            },
            "required": [
              "building_project_type"
            ]
          },
          "then": {
            "required": [
              "mf_num_bedrooms"
            ]
          },
          "else": {
            "required": [
              "sf_num_bedrooms"
            ]
          }
        }
      },
      {
        "$comment": "Determine when limited_assessment is required or not allowed",
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
            },
            "construction_type": {
              "const": "EXISTING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "required": [
            "limited_assessment"
          ]
        }
      },
      {
        "$comment": "Determine when ahri_reference_number, model_number, product_description and upc in product_info are required, optional, or not allowed",
        "properties": {
          "product_info": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "ahri_reference_number"
                  ],
                  "error_msg": "'ahri_reference_number' is required in 'product_info' item."
                },
                {
                  "required": [
                    "model_number"
                  ],
                  "error_msg": "'model_number' is required in 'product_info' item."
                },
                {
                  "required": [
                    "upc"
                  ],
                  "error_msg": "'upc' is required in 'product_info' item."
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "upgrade_type": {
              "const": "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING"
            }
          },
          "required": [
            "upgrade_type"
          ]
        },
        "then": {
          "properties": {
            "product_info": {
              "items": {
                "anyOf": [
                  {
                    "required": [
                      "ahri_reference_number"
                    ],
                    "error_msg": "'ahri_reference_number' is required in 'product_info' item."
                  },
                  {
                    "required": [
                      "model_number"
                    ],
                    "error_msg": "'model_number' is required in 'product_info' item."
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "not": {
            "properties": {
              "upgrade_type": {
                "enum": [
                  "HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING",
                  "HEAT_PUMP_WATER_HEATER"
                ]
              }
            }
          }
        },
        "then": {
          "properties": {
            "product_info": {
              "items": {
                "not": {
                  "required": [
                    "ahri_reference_number"
                  ],
                  "error_msg": "'ahri_reference_number' must not be provided in 'product_info' item if 'upgrade_type' is not 'HEAT_PUMP_FOR_SPACE_HEATING_OR_COOLING' or 'HEAT_PUMP_WATER_HEATER'."
                }
              }
            }
          }
        }
      },
      {
        "$comment": "Determine when state_attests_new_construction_cost_effectiveness is required",
        "if": {
          "allOf": [
            {
              "properties": {
                "construction_type": {
                  "const": "NEW"
                }
              }
            },
            {
              "not": {
                "properties": {
                  "upgrade_type": {
                    "enum": [
                      "ELECTRIC_WIRING",
                      "ELECTRICAL_PANEL"
                    ]
                  }
                }
              }
            }
          ]
        },
        "then": {
          "required": [
            "state_attests_new_construction_cost_effectiveness"
          ],
          "properties": {
            "state_attests_new_construction_cost_effectiveness": {
              "const": "YES"
            }
          }
        }
      }
    ]
  }
}
