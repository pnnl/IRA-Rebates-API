{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/homesReservation",
  "type": "object",
  "title": "Homes Reservations Payload",
  "properties": {
    "address_id": {
      "$ref": "/schemas/definitions#address_id"
    },
    "applicant_id": {
      "$ref": "/schemas/definitions#applicant_id"
    },
    "building_project_type": {
      "$ref": "/schemas/definitions#homes_building_project_type"
    },
    "claimant_type": {
      "$ref": "/schemas/definitions#homes_claimant_type"
    },
    "construction_type": {
      "$ref": "/schemas/definitions#construction_type"
    },
    "contractor_company_name": {
      "$ref": "/schemas/definitions#contractor_company_name"
    },
    "contractor_dac_incentive": {
      "$ref": "/schemas/definitions#contractor_dac_incentive"
    },
    "contractor_name": {
      "$ref": "/schemas/definitions#contractor_name"
    },
    "dwelling_unit_income_bucket": {
      "$ref": "/schemas/definitions#homes_dwelling_unit_income_bucket"
    },
    "estimated_percent_energy_savings": {
      "$ref": "/schemas/definitions#estimated_percent_energy_savings"
    },
    "estimated_post_retrofit_energy_usage_kwh_equivalent": {
      "$ref": "/schemas/definitions#estimated_post_retrofit_energy_usage_kwh_equivalent"
    },
    "estimated_post_retrofit_site_energy_usages_by_fuel_type": {
      "$ref": "/schemas/definitions#estimated_post_retrofit_site_energy_usages_by_fuel_type"
    },
    "external_rebate_id": {
      "$ref": "/schemas/definitions#external_rebate_id"
    },
    "is_contractor_eligible": {
      "$ref": "/schemas/definitions#is_contractor_eligible"
    },
    "is_disadvantaged_community": {
      "$ref": "/schemas/definitions#is_disadvantaged_community"
    },
    "measured_pre_retrofit_energy_usage_kwh_equivalent": {
      "$ref": "/schemas/definitions#measured_pre_retrofit_energy_usage_kwh_equivalent"
    },
    "measured_pre_retrofit_site_energy_usages_by_fuel_type": {
      "$ref": "/schemas/definitions#measured_pre_retrofit_site_energy_usages_by_fuel_type"
    },
    "mf_building_income_bucket": {
      "$ref": "/schemas/definitions#homes_mf_building_income_bucket"
    },
    "modeled_percent_energy_savings": {
      "$ref": "/schemas/definitions#modeled_percent_energy_savings"
    },
    "modeled_post_retrofit_energy_usage_kwh_equivalent": {
      "$ref": "/schemas/definitions#modeled_post_retrofit_energy_usage_kwh_equivalent"
    },
    "modeled_post_retrofit_site_energy_usages_by_fuel_type": {
      "$ref": "/schemas/definitions#modeled_post_retrofit_site_energy_usages_by_fuel_type"
    },
    "modeled_pre_retrofit_energy_usage_kwh_equivalent": {
      "$ref": "/schemas/definitions#modeled_pre_retrofit_energy_usage_kwh_equivalent"
    },
    "modeled_pre_retrofit_site_energy_usages_by_fuel_type": {
      "$ref": "/schemas/definitions#modeled_pre_retrofit_site_energy_usages_by_fuel_type"
    },
    "modeling_software_used": {
      "$ref": "/schemas/definitions#modeling_software_used"
    },
    "num_occupied_units": {
      "$ref": "/schemas/definitions#num_occupied_units"
    },
    "num_units": {
      "$ref": "/schemas/definitions#num_units"
    },
    "num_units_meeting_income_bucket": {
      "$ref": "/schemas/definitions#num_units_meeting_income_bucket"
    },
    "portfolio_id": {
      "$ref": "/schemas/definitions#portfolio_id"
    },
    "project_id": {
      "$ref": "/schemas/definitions#project_id"
    },
    "rebate_type": {
      "$ref": "/schemas/definitions#rebate_type"
    },
    "reservation_amount": {
      "$ref": "/schemas/definitions#homes_reservation_amount"
    },
    "software_used_to_estimate_post_retrofit_energy_usage": {
      "$ref": "/schemas/definitions#software_used_to_estimate_post_retrofit_energy_usage"
    },
    "state_attests_proof_of_identity_ownership_income": {
      "$ref": "/schemas/definitions#state_attests_proof_of_identity_ownership_income",
      "const": true
    },
    "unit_name_or_number": {
      "$ref": "/schemas/definitions#unit_name_or_number"
    },
    "upgrades": {
      "$ref": "/schemas/definitions#homes_upgrades"
    }
  },
  "required": [
    "address_id",
    "applicant_id",
    "building_project_type",
    "claimant_type",
    "construction_type",
    "contractor_company_name",
    "contractor_name",
    "is_contractor_eligible",
    "rebate_type",
    "state_attests_proof_of_identity_ownership_income",
    "upgrades"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Determine when portfolio_id is required or not allowed",
      "if": {
        "properties": {
          "claimant_type": {
            "const": "AGGREGATOR"
          }
        },
        "required": [
          "claimant_type"
        ]
      },
      "then": {
        "required": [
          "portfolio_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "portfolio_id"
          ]
        },
        "error_msg": "'portfolio_id' is not allowed when 'claimant_type' is not 'AGGREGATOR'."
      }
    },
    {
      "$comment": "Determine which fields are required or not allowed when rebate_type is MODELED or MEASURED",
      "if": {
        "properties": {
          "rebate_type": {
            "const": "MODELED"
          }
        },
        "required": [
          "rebate_type"
        ]
      },
      "then": {
        "required": [
          "modeling_software_used"
        ],
        "allOf": [
          {
            "oneOf": [
              {
                "required": [
                  "modeled_post_retrofit_energy_usage_kwh_equivalent",
                  "modeled_pre_retrofit_energy_usage_kwh_equivalent"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "modeled_percent_energy_savings"
                      ]
                    },
                    {
                      "required": [
                        "modeled_post_retrofit_site_energy_usages_by_fuel_type"
                      ]
                    },
                    {
                      "required": [
                        "modeled_pre_retrofit_site_energy_usages_by_fuel_type"
                      ]
                    }
                  ]
                },
                "error_msg": "If 'rebate_type' is 'MODELED', and 'modeled_post_retrofit_energy_usage_kwh_equivalent' and 'modeled_pre_retrofit_energy_usage_kwh_equivalent' are provided then 'modeled_percent_energy_savings', 'modeled_post_retrofit_site_energy_usages_by_fuel_type', and 'modeled_pre_retrofit_site_energy_usages_by_fuel_type' must not be provided."
              },
              {
                "required": [
                  "modeled_percent_energy_savings",
                  "modeled_post_retrofit_site_energy_usages_by_fuel_type",
                  "modeled_pre_retrofit_site_energy_usages_by_fuel_type"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "modeled_post_retrofit_energy_usage_kwh_equivalent"
                      ]
                    },
                    {
                      "required": [
                        "modeled_pre_retrofit_energy_usage_kwh_equivalent"
                      ]
                    }
                  ]
                },
                "error_msg": "If 'rebate_type' is 'MODELED', and 'modeled_percent_energy_savings', 'modeled_post_retrofit_site_energy_usages_by_fuel_type', and 'modeled_pre_retrofit_site_energy_usages_by_fuel_type' are provided then 'modeled_post_retrofit_energy_usage_kwh_equivalent' and 'modeled_pre_retrofit_energy_usage_kwh_equivalent' must not be provided."
              }
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "estimated_percent_energy_savings"
                  ]
                },
                {
                  "required": [
                    "estimated_post_retrofit_energy_usage_kwh_equivalent"
                  ]
                },
                {
                  "required": [
                    "estimated_post_retrofit_site_energy_usages_by_fuel_type"
                  ]
                },
                {
                  "required": [
                    "measured_pre_retrofit_energy_usage_kwh_equivalent"
                  ]
                },
                {
                  "required": [
                    "measured_pre_retrofit_site_energy_usages_by_fuel_type"
                  ]
                },
                {
                  "required": [
                    "reservation_amount"
                  ]
                },
                {
                  "required": [
                    "software_used_to_estimate_post_retrofit_energy_usage"
                  ]
                }
              ]
            },
            "error_msg": "If 'rebate_type' is 'MODELED', then 'estimated_percent_energy_savings', 'estimated_post_retrofit_energy_usage_kwh_equivalent', 'estimated_post_retrofit_site_energy_usages_by_fuel_type', 'measured_pre_retrofit_energy_usage_kwh_equivalent', 'measured_pre_retrofit_site_energy_usages_by_fuel_type', 'reservation_amount', and 'software_used_to_estimate_post_retrofit_energy_usage' must not be provided."
          }
        ]
      },
      "else": {
        "$comment": "rebate_type is MEASURED",
        "required": [
          "reservation_amount",
          "software_used_to_estimate_post_retrofit_energy_usage"
        ],
        "oneOf": [
          {
            "required": [
              "estimated_post_retrofit_energy_usage_kwh_equivalent",
              "measured_pre_retrofit_energy_usage_kwh_equivalent"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "estimated_percent_energy_savings"
                  ]
                },
                {
                  "required": [
                    "estimated_post_retrofit_site_energy_usages_by_fuel_type"
                  ]
                },
                {
                  "required": [
                    "measured_pre_retrofit_site_energy_usages_by_fuel_type"
                  ]
                }
              ]
            },
            "error_msg": "If 'rebate_type' is not 'MODELED', and 'estimated_post_retrofit_energy_usage_kwh_equivalent' and 'measured_pre_retrofit_energy_usage_kwh_equivalent' are provided then 'estimated_percent_energy_savings', 'estimated_post_retrofit_site_energy_usages_by_fuel_type', and 'measured_pre_retrofit_site_energy_usages_by_fuel_type' must not be provided."
          },
          {
            "required": [
              "estimated_percent_energy_savings",
              "estimated_post_retrofit_site_energy_usages_by_fuel_type",
              "measured_pre_retrofit_site_energy_usages_by_fuel_type"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "estimated_post_retrofit_energy_usage_kwh_equivalent"
                  ]
                },
                {
                  "required": [
                    "measured_pre_retrofit_energy_usage_kwh_equivalent"
                  ]
                }
              ]
            },
            "error_msg": "If 'rebate_type' is not 'MODELED', and 'estimated_percent_energy_savings', 'estimated_post_retrofit_site_energy_usages_by_fuel_type', and 'measured_pre_retrofit_site_energy_usages_by_fuel_type' are provided then 'estimated_post_retrofit_energy_usage_kwh_equivalent' and 'measured_pre_retrofit_energy_usage_kwh_equivalent' must not be provided."
          }
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "modeled_percent_energy_savings"
              ]
            },
            {
              "required": [
                "modeled_post_retrofit_energy_usage_kwh_equivalent"
              ]
            },
            {
              "required": [
                "modeled_post_retrofit_site_energy_usages_by_fuel_type"
              ]
            },
            {
              "required": [
                "modeled_pre_retrofit_energy_usage_kwh_equivalent"
              ]
            },
            {
              "required": [
                "modeled_pre_retrofit_site_energy_usages_by_fuel_type"
              ]
            },
            {
              "required": [
                "modeling_software_used"
              ]
            }
          ]
        },
        "error_msg": "If 'rebate_type' is not 'MODELED', then 'modeling_software_used', 'modeled_percent_energy_savings', 'modeled_post_retrofit_energy_usage_kwh_equivalent', 'modeled_post_retrofit_site_energy_usages_by_fuel_type', 'modeled_pre_retrofit_energy_usage_kwh_equivalent', 'modeled_pre_retrofit_site_energy_usages_by_fuel_type' must not be provided."
      }
    },
    {
      "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_IN_UNIT",
      "if": {
        "properties": {
          "building_project_type": {
            "const": "MULTIFAMILY_IN_UNIT"
          }
        },
        "required": [
          "building_project_type"
        ]
      },
      "then": {
        "required": [
          "dwelling_unit_income_bucket",
          "unit_name_or_number"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "mf_building_income_bucket"
              ]
            },
            {
              "required": [
                "num_units_meeting_income_bucket"
              ]
            },
            {
              "required": [
                "num_occupied_units"
              ]
            }
          ]
        }
      }
    },
    {
      "$comment": "Determine which fields are required or not allowed when building_project_type is MULTIFAMILY_CENTRAL",
      "if": {
        "properties": {
          "building_project_type": {
            "const": "MULTIFAMILY_CENTRAL"
          }
        },
        "required": [
          "building_project_type"
        ]
      },
      "then": {
        "required": [
          "mf_building_income_bucket",
          "num_occupied_units",
          "num_units",
          "num_units_meeting_income_bucket"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "dwelling_unit_income_bucket"
              ]
            },
            {
              "required": [
                "unit_name_or_number"
              ]
            }
          ]
        }
      }
    },
    {
      "$comment": "Determine which fields are required or not allowed for single family building_project_type",
      "if": {
        "properties": {
          "building_project_type": {
            "enum": [
              "MANUFACTURED",
              "SINGLE_FAMILY_ATTACHED",
              "SINGLE_FAMILY_DETACHED"
            ]
          }
        },
        "required": [
          "building_project_type"
        ]
      },
      "then": {
        "required": [
          "dwelling_unit_income_bucket"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "mf_building_income_bucket"
              ]
            },
            {
              "required": [
                "num_occupied_units"
              ]
            },
            {
              "required": [
                "num_units"
              ]
            },
            {
              "required": [
                "num_units_meeting_income_bucket"
              ]
            }
          ]
        }
      }
    }
  ]
}
