{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/pipeInsulation",
  "type": "object",
  "title": "Pipe Insulation",
  "properties": {
    "original_component_details": {
      "$anchor": "original_component_details",
      "type": "object",
      "title": "Pipe Insulation Original Component Details",
      "description": "The preexisting conditions associated with this improvement",
      "properties": {
        "primary_pipe_location": {
          "description": "The type of space in which the majority of the pipes being treated are located.",
          "enum": [
            "CONDITIONED_SPACE",
            "DO_NOT_KNOW",
            "UNCONDITIONED_SPACE"
          ]
        },
        "upgrade_subtype": {
          "$ref": "#/$defs/upgrade_subtype"
        }
      },
      "required": [
        "primary_pipe_location",
        "upgrade_subtype"
      ],
      "additionalProperties": false
    },
    "upgrade_component_details": {
      "$anchor": "upgrade_component_details",
      "title": "Pipe Insulation Upgrade Component Details",
      "type": "object",
      "description": "Details that describe this improvement",
      "properties": {
        "percent_pipes_receiving_additional_insulation": {
          "description": "The percentage of the pipes that received additional insulation in the upgrade. Choose the closest percentage.",
          "enum": [
            10,
            25,
            50,
            75,
            100
          ]
        },
        "upgrade_subtype": {
          "$ref": "#/$defs/upgrade_subtype"
        }
      },
      "required": [
        "percent_pipes_receiving_additional_insulation",
        "upgrade_subtype"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "upgrade_subtype": {
      "const": "PIPE_INSULATION"
    }
  }
}
