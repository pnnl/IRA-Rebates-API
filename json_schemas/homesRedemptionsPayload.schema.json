{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ira-rebates.labworks.org/schemas/homesRedemption",
  "type": "object",
  "title": "Homes Redemptions Payload",
  "properties": {
    "equipment_and_material_cost": {
      "$ref": "/schemas/definitions#homes_equipment_and_material_cost"
    },
    "installation_cost": {
      "$ref": "/schemas/definitions#installation_cost"
    },
    "is_contractor_eligible": {
      "$ref": "/schemas/definitions#is_contractor_eligible",
      "const": true
    },
    "measured_percent_energy_savings": {
      "$ref": "/schemas/definitions#measured_percent_energy_savings"
    },
    "measured_post_retrofit_energy_usage_kwh_equivalent": {
      "$ref": "/schemas/definitions#measured_post_retrofit_energy_usage_kwh_equivalent"
    },
    "measured_post_retrofit_site_energy_usages_by_fuel_type": {
      "$ref": "/schemas/definitions#measured_post_retrofit_site_energy_usages_by_fuel_type"
    },
    "post_retrofit_inspection_passed": {
      "$ref": "/schemas/definitions#post_retrofit_inspection_passed"
    },
    "project_completion_date": {
      "$ref": "/schemas/definitions#project_completion_date"
    },
    "rebate_deducted": {
      "$ref": "/schemas/definitions#rebate_deducted"
    },
    "rebate_type": {
      "$ref": "/schemas/definitions#rebate_type"
    },
    "safety_checks": {
      "$ref": "/schemas/definitions#safety_checks"
    },
    "total_rebate_payout": {
      "$ref": "/schemas/definitions#total_rebate_payout"
    },
    "vendor_id": {
      "$ref": "/schemas/definitions#vendor_id"
    }
  },
  "required": [
    "is_contractor_eligible",
    "project_completion_date",
    "rebate_deducted",
    "rebate_type",
    "safety_checks",
    "vendor_id"
  ],
  "anyOf": [
    {
      "required": [
        "equipment_and_material_cost"
      ],
      "error_msg": "'equipment_and_material_cost' is required."
    },
    {
      "required": [
        "installation_cost"
      ],
      "error_msg": "'installation_cost' is required."
    }
  ],
  "if": {
    "properties": {
      "rebate_type": {
        "const": "MEASURED"
      }
    },
    "required": [
      "rebate_type"
    ]
  },
  "then": {
    "required": [
      "total_rebate_payout"
    ],
    "oneOf": [
      {
        "required": [
          "measured_post_retrofit_energy_usage_kwh_equivalent"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "measured_percent_energy_savings"
              ]
            },
            {
              "required": [
                "measured_post_retrofit_site_energy_usages_by_fuel_type"
              ]
            }
          ]
        },
        "error_msg": "If 'rebate_type' is 'MEASURED', and 'measured_post_retrofit_energy_usage_kwh_equivalent' is  provided then 'measured_percent_energy_savings' and 'measured_post_retrofit_site_energy_usages_by_fuel_type' must not be provided."
      },
      {
        "required": [
          "measured_percent_energy_savings",
          "measured_post_retrofit_site_energy_usages_by_fuel_type"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "measured_post_retrofit_energy_usage_kwh_equivalent"
              ]
            }
          ]
        },
        "error_msg": "If 'rebate_type' is 'MEASURED', and 'measured_percent_energy_savings' and 'measured_post_retrofit_site_energy_usages_by_fuel_type' are provided then 'measured_post_retrofit_energy_usage_kwh_equivalent' must not be provided."
      }
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "measured_post_retrofit_energy_usage_kwh_equivalent"
          ]
        },
        {
          "required": [
            "measured_post_retrofit_site_energy_usages_by_fuel_type"
          ]
        },
        {
          "required": [
            "measured_percent_energy_savings"
          ]
        }
      ]
    },
    "error_msg": "If 'rebate_type' is not 'MEASURED', then 'measured_post_retrofit_energy_usage_kwh_equivalent', 'measured_post_retrofit_site_energy_usages_by_fuel_type', and 'measured_percent_energy_savings' must not be provided."
  },
  "additionalProperties": false
}
