    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:HVACSystems/auc:HVACSystem[auc:Plants and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/auc:Plants/auc:CoolingPlants/auc:CoolingPlant/auc:ControlSystemTypes">
      <sch:assert test="count(auc:ControlSystemType) &gt;= 0">element "auc:ControlSystemType" is OPTIONAL</sch:assert>
