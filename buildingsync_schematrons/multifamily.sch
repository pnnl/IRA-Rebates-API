      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Date For Level 1: Walk-through Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AuditDates/auc:AuditDate[auc:DateType/text() = 'Custom' and auc:CustomDateType/text() = 'Level 1: Walk-through']/auc:Date)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Date For Level 2: Energy Survey and Analysis Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AuditDates/auc:AuditDate[auc:DateType/text() = 'Custom' and auc:CustomDateType/text() = 'Level 2: Energy Survey and Analysis']/auc:Date)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Date For Level 3: Detailed Survey and Analysis Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AuditDates/auc:AuditDate[auc:DateType/text() = 'Custom' and auc:CustomDateType/text() = 'Level 3: Detailed Survey and Analysis']/auc:Date)"/>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>Building Owner, Property Manager, Auditor Details</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']">
      <sch:assert test="count(auc:Qualifications) &gt;= 0">element "auc:Qualifications" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:UserDefinedFields) &gt;= 1">element "auc:UserDefinedFields" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Qualifications">
      <sch:assert test="count(auc:Qualification) &gt;= 0">element "auc:Qualification" is OPTIONAL</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Qualifications/auc:Qualification">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:AuditorQualification) &gt;= 1">element "auc:AuditorQualification" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:CertifiedAuditTeamMemberContactID[@IDref = ancestor::auc:Facility/auc:Contacts/auc:Contact/@ID]) &gt;= 1">element "auc:CertifiedAuditTeamMemberContactID[@IDref = ancestor::auc:Facility/auc:Contacts/auc:Contact/@ID]" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Qualifications/auc:Qualification/auc:AuditorQualification">
      <sch:assert test="contains('_Association of Energy Engineers Certified Energy Auditor (CEA)_ _Association of Energy Engineers Certified Energy Manager (CEM)_ _Building Performance Institute (BPI): Multifamily Building Analyst_ _High-Performance Building Design Professional (HBDP)_ _New York State Energy Research and Development Authority (NYSERDA) FlexTech Consultant_ _Other_', concat('_', text(), '_'))">text "<sch:value-of select="text()"/>": element "text()" MUST be "Association of Energy Engineers Certified Energy Auditor (CEA)", "Association of Energy Engineers Certified Energy Manager (CEM)", "Building Performance Institute (BPI): Multifamily Building Analyst", "High-Performance Building Design Professional (HBDP)", "New York State Energy Research and Development Authority (NYSERDA) FlexTech Consultant", or "Other"</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Qualifications/auc:Qualification/auc:CertifiedAuditTeamMemberContactID[@IDref = ancestor::auc:Facility/auc:Contacts/auc:Contact/@ID]">
      <sch:assert test="count(@IDref) &gt;= 1">element "@IDref" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:UserDefinedFields">
      <sch:assert test="count(auc:UserDefinedField[auc:FieldName/text() = 'Auditor Years Of Experience']) &gt;= 1">element "auc:UserDefinedField[auc:FieldName/text() = 'Auditor Years Of Experience']" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Auditor Years Of Experience']">
      <sch:assert test="count(auc:FieldName) &gt;= 1">element "auc:FieldName" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:FieldValue) &gt;= 1">element "auc:FieldValue" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Auditor Years Of Experience']/auc:FieldName">
      <sch:assert test="contains('_Auditor Years Of Experience_', concat('_', text(), '_'))">text "<sch:value-of select="text()"/>": element "text()" MUST be "Auditor Years Of Experience"</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Auditor Years Of Experience']/auc:FieldValue">
      <sch:assert test="(number(text()) = text()) and (number() &gt;= 0)">text "<sch:value-of select="text()"/>": element "text()" MUST be a number and MUST be greater than or equal to 0</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility">
      <sch:assert test="count(auc:Contacts/auc:Contact) &gt;= 0">element "auc:Contacts/auc:Contact" is OPTIONAL</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Contacts/auc:Contact">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>Building Owner, Property Manager, Auditor Details (Audit Template Contact Role Requiements)</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']">
      <sch:assert test="count(ancestor::auc:Facility/auc:Contacts/auc:Contact[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/@ID)]/auc:FieldValue/text() = 'Energy Auditor']) &gt; 0"/>
      <sch:assert test="count(ancestor::auc:Facility/auc:Contacts/auc:Contact[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/@ID)]/auc:FieldValue/text() = 'Owner']) &gt; 0"/>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>Building Owner, Property Manager, Auditor Details (Audit Template Certificate Lists)</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Qualifications/auc:Qualification">
      <sch:assert test="count(ancestor::auc:Facility/auc:Contacts/auc:Contact[@ID = current()/auc:CertifiedAuditTeamMemberContactID/@IDref and auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/ancestor::auc:Report/@ID)]/auc:FieldValue/text() = 'Energy Auditor' and auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/@ID)]/auc:FieldValue/text() = 'Energy Auditor']) &gt; 0"/>
      <sch:assert test="(auc:AuditorQualification/text() != 'Other') or count(ancestor::auc:Facility/auc:Contacts/auc:Contact[@ID = current()/auc:CertifiedAuditTeamMemberContactID/@IDref and auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/ancestor::auc:Report/@ID)]/auc:FieldValue/text() = 'Energy Auditor' and auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Contact Role For ', current()/@ID)]/auc:FieldValue/text() = 'Energy Auditor' and auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = concat('Other Qualification Type For ', current()/@ID)]/auc:FieldValue/text() != '']) &gt; 0"/>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>General Information</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site">
      <sch:assert test="count(auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]) &gt;= 1">element "auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:BuildingAutomationSystem) &gt;= 1">element "auc:BuildingAutomationSystem" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:ConditionedFloorsAboveGrade) &gt;= 1">element "auc:ConditionedFloorsAboveGrade" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:ConditionedFloorsBelowGrade) &gt;= 1">element "auc:ConditionedFloorsBelowGrade" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:FloorAreas) &gt;= 1">element "auc:FloorAreas" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:HistoricalLandmark) &gt;= 1">element "auc:HistoricalLandmark" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:Sections) &gt;= 1">element "auc:Sections" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:BuildingAutomationSystem">
      <sch:assert test="contains('_false_ _true_', concat('_', text(), '_'))">text "<sch:value-of select="text()"/>": element "text()" MUST be "false" or "true"</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:ConditionedFloorsAboveGrade">
      <sch:assert test="(number(text()) = text()) and (number() &gt;= 0)">text "<sch:value-of select="text()"/>": element "text()" MUST be a number and MUST be greater than or equal to 0</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:ConditionedFloorsBelowGrade">
      <sch:assert test="(number(text()) = text()) and (number() &gt;= 0)">text "<sch:value-of select="text()"/>": element "text()" MUST be a number and MUST be greater than or equal to 0</sch:assert>
