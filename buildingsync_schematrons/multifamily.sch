    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:TotalExteriorAboveGradeWallArea">
