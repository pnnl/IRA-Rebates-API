  <sch:pattern>
    <sch:title>HVAC System: Air Handling Unit (Not Applicable)</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]">
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Other Central Distribution Type Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Other Central Distribution Type']/auc:FieldValue)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Other Distribution Equipment Type Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Other Distribution Equipment Type']/auc:FieldValue)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Outdoor Air Type Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:HeatingAndCoolingSystems/auc:Deliveries/auc:Delivery/auc:DeliveryType/auc:ZoneEquipment/auc:FanBased/auc:AirSideEconomizer/auc:AirSideEconomizerType | auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Outdoor Air Type']/auc:FieldValue)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Ventilation Type Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:OtherHVACSystems/auc:OtherHVACSystem/auc:OtherHVACType/auc:MechanicalVentilation/auc:VentilationType)"/>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:HeatingAndCoolingSystems/auc:HeatingSources/auc:HeatingSource">
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Annual Heating Efficiency Units Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AnnualHeatingEfficiencyUnits)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Annual Heating Efficiency Value Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AnnualHeatingEfficiencyValue)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Heating Source Condition Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:HeatingSourceCondition)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Location Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:Location)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Output Capacity Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:OutputCapacity)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Primary Fuel Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:PrimaryFuel)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Quantity Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:Quantity)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Source Heating Plant ID Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:HeatingSourceType/auc:SourceHeatingPlantID)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Year Installed Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:YearInstalled)"/>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:HeatingAndCoolingSystems/auc:CoolingSources/auc:CoolingSource">
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Annual Cooling Efficiency Units Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AnnualCoolingEfficiencyUnits)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Annual Cooling Efficiency Value Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:AnnualCoolingEfficiencyValue)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Capacity Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:Capacity)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Cooling Plant ID Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:CoolingSourceType/auc:CoolingPlantID)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Cooling Source Condition Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:CoolingSourceCondition)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Location Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:Location)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Primary Fuel Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:PrimaryFuel)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Quantity Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:Quantity)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Year Installed Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:YearInstalled)"/>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>HVAC System: Air Handling Unit (Plants)</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]">
      <sch:assert test="count(ancestor::auc:Facility/auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = current()/@ID]) = count(ancestor::auc:Facility/auc:Systems/auc:FanSystems/auc:FanSystem[auc:LinkedSystemIDs/auc:LinkedSystemID/@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID])"/>
    </sch:rule>
  </sch:pattern>
  <sch:pattern>
    <sch:title>SHW System</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems">
      <sch:assert test="count(auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]) &gt;= 0">element "auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]" is OPTIONAL</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:DomesticHotWaterType) &gt;= 1">element "auc:DomesticHotWaterType" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:LinkedPremises) &gt;= 1">element "auc:LinkedPremises" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:Location) &gt;= 0">element "auc:Location" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:PrimaryFuel) &gt;= 0">element "auc:PrimaryFuel" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:UserDefinedFields) &gt;= 0">element "auc:UserDefinedFields" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:WaterHeaterEfficiency) &gt;= 0">element "auc:WaterHeaterEfficiency" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:WaterHeaterEfficiencyType) &gt;= 0">element "auc:WaterHeaterEfficiencyType" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:YearInstalled) &gt;= 0">element "auc:YearInstalled" is OPTIONAL</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/auc:DomesticHotWaterType">
      <sch:assert test="not(auc:HeatExchanger)">element "auc:HeatExchanger" is NOT RECOMMENDED</sch:assert>
      <sch:assert test="count(auc:Instantaneous) &gt;= 0">element "auc:Instantaneous" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:Other) &gt;= 0">element "auc:Other" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:StorageTank) &gt;= 0">element "auc:StorageTank" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:StorageTank | auc:Instantaneous | auc:Other | auc:Unknown) &gt;= 1">element "auc:StorageTank | auc:Instantaneous | auc:Other | auc:Unknown" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:Unknown) &gt;= 0">element "auc:Unknown" is OPTIONAL</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/auc:DomesticHotWaterType/auc:Instantaneous">
      <sch:assert test="count(auc:InstantaneousWaterHeatingSource) &gt;= 1">element "auc:InstantaneousWaterHeatingSource" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/auc:DomesticHotWaterType/auc:Instantaneous/auc:InstantaneousWaterHeatingSource">
      <sch:assert test="count(auc:Combustion) &gt;= 1">element "auc:Combustion" is REQUIRED</sch:assert>
      <sch:assert test="not(auc:ElectricResistance)">element "auc:ElectricResistance" is NOT RECOMMENDED</sch:assert>
      <sch:assert test="not(auc:Other)">element "auc:Other" is NOT RECOMMENDED</sch:assert>
      <sch:assert test="not(auc:Unknown)">element "auc:Unknown" is NOT RECOMMENDED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:DomesticHotWaterSystems/auc:DomesticHotWaterSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/auc:DomesticHotWaterType/auc:Instantaneous/auc:InstantaneousWaterHeatingSource/auc:Combustion">
