    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:RoofSystems/auc:RoofSystem[@ID = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:Sections/auc:Section[auc:SectionType/text() = 'Whole building']/auc:Roofs/auc:Roof/auc:RoofID/@IDref]">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:BlueRoof) &gt;= 1">element "auc:BlueRoof" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:CoolRoof) &gt;= 1">element "auc:CoolRoof" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:GreenRoof) &gt;= 1">element "auc:GreenRoof" is REQUIRED</sch:assert>
