      <sch:assert test="count(auc:UserDefinedField[auc:FieldName/text() = 'Implementation Year']) &gt;= 1">element "auc:UserDefinedField[auc:FieldName/text() = 'Implementation Year']" is REQUIRED</sch:assert>
    </sch:rule>
