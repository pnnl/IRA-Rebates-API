    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:Scenarios/auc:Scenario[auc:ScenarioName/text() = 'benchmark' and auc:ScenarioType/auc:Benchmark]/auc:AllResourceTotals/auc:AllResourceTotal">
      <sch:assert test="count(@ID) &gt;= 1">element "@ID" is REQUIRED</sch:assert>
