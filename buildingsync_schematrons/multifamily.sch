      <sch:assert test="count(auc:CondenserPlantIDs) &gt;= 0">element "auc:CondenserPlantIDs" is OPTIONAL</sch:assert>
      <sch:assert test="count(auc:Quantity) &gt;= 0">element "auc:Quantity" is OPTIONAL</sch:assert>
