      <sch:assert test="count(auc:FloorArea[auc:FloorAreaType/text() = 'Cooled only']) &gt;= 1">element "auc:FloorArea[auc:FloorAreaType/text() = 'Cooled only']" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:FloorArea[auc:FloorAreaType/text() = 'Gross']) &gt;= 1">element "auc:FloorArea[auc:FloorAreaType/text() = 'Gross']" is REQUIRED</sch:assert>
      <sch:assert test="count(auc:FloorArea[auc:FloorAreaType/text() = 'Heated and Cooled']) &gt;= 1">element "auc:FloorArea[auc:FloorAreaType/text() = 'Heated and Cooled']" is REQUIRED</sch:assert>
