    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:FanSystems/auc:FanSystem[auc:LinkedSystemIDs/auc:LinkedSystemID/@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID]/auc:LinkedSystemIDs">
      <sch:assert test="count(auc:LinkedSystemID[@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID]) &gt;= 1">element "auc:LinkedSystemID[@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID]" is REQUIRED</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:FanSystems/auc:FanSystem[auc:LinkedSystemIDs/auc:LinkedSystemID/@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID]/auc:LinkedSystemIDs/auc:LinkedSystemID[@IDref = ancestor::auc:Systems/auc:HVACSystems/auc:HVACSystem[count(auc:Plants) = 0 and auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]/@ID]">
