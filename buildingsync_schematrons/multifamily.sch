    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems/auc:FoundationSystems/auc:FoundationSystem[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Linked Wall ID']/auc:FieldValue and @ID = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/auc:Sections/auc:Section[auc:SectionType/text() = 'Whole building']/auc:Foundations/auc:Foundation/auc:FoundationID/@IDref]/auc:GroundCouplings/auc:GroundCoupling/auc:Basement/auc:FoundationWallRValue">
      <sch:assert test="(number(text()) = text()) and (number() &gt;= 0)">text "<sch:value-of select="text()"/>": element "text()" MUST be a number and MUST be greater than or equal to 0</sch:assert>
