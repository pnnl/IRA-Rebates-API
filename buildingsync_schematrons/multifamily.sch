      <sch:assert test="contains('_Implementation Year_', concat('_', text(), '_'))">text "<sch:value-of select="text()"/>": element "text()" MUST be "Implementation Year"</sch:assert>
    </sch:rule>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Measures/auc:Measure/auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Implementation Year']/auc:FieldValue">
      <sch:assert test="(number(text()) = text()) and (number() &gt;= 1800)">text "<sch:value-of select="text()"/>": element "text()" MUST be a number and MUST be greater than or equal to 1800</sch:assert>
    </sch:rule>
  </sch:pattern>
