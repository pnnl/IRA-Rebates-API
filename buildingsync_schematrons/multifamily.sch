  </sch:pattern>
  <sch:pattern>
    <sch:title>Lighting System</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Systems">
      <sch:assert test="count(auc:LightingSystems/auc:LightingSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]) &gt;= 0">element "auc:LightingSystems/auc:LightingSystem[auc:LinkedPremises/auc:Building/auc:LinkedBuildingID/@IDref = ancestor::auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]/@ID]" is OPTIONAL</sch:assert>
