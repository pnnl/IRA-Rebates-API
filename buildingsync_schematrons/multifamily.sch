  <sch:pattern>
    <sch:title>Audit Details (Not Applicable)</sch:title>
    <sch:rule context="/auc:BuildingSync/auc:Facilities/auc:Facility/auc:Sites/auc:Site/auc:Buildings/auc:Building[@ID = ancestor::auc:Facility/auc:Reports/auc:Report[auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Audit Template Report Type']/auc:FieldValue/text() = '50121 HOMES Template']/auc:LinkedPremisesOrSystem/auc:Building/auc:LinkedBuildingID/@IDref]">
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Retrocommissioning Date Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:RetrocommissioningDate)"/>
      <sch:assert test="auc:UserDefinedFields/auc:UserDefinedField[auc:FieldName/text() = 'Year Of Last Energy Audit Is Not Applicable']/auc:FieldValue[text() = 'true'] or (auc:YearOfLastEnergyAudit)"/>
